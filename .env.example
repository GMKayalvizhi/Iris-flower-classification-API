# Copy this file to .env and adjust values for your local environment.
# Do not commit .env. This file documents what configuration is
# expected so anyone cloning the repo knows exactly what to set up.

MODEL_PATH=ml/saved_model/model.joblib
MODEL_INFO_PATH=ml/saved_model/model_info.json
LOG_LEVEL=INFO
MAX_BATCH_SIZE=100
API_TITLE=Iris Flower Classification API
API_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000